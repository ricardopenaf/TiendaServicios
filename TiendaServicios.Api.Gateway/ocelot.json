{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Autor",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tiendaservicio.api.autor",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/v1/autores",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Autor/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tiendaservicio.api.autor",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/v1/autores/{id}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/Libro",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tiendaservicios.api.libro",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/v1/libros",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Libro/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tiendaservicios.api.libro",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/v1/libros/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
      "DelegatingHandlers": [ "LibroHandler" ]
    },
    {
      "DownstreamPathTemplate": "/api/CarritoCompras",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tiendaservicios.api.carritocompra",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/v1/carritos",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/CarritoCompras/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tiendaservicios.api.carritocompra",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/v1/carritos/{id}",
      "UpstreamHttpMethod": [ "GET" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5100"
  }
}
